# Contest data
# Only contests/Sample_contest/ is committed. Every other contest folder is
# ignored, including its files and subfolders.
contests/*
!contests/Sample_contest/
!contests/Sample_contest/**
# Generated testcases and zips (ignored everywhere, sample contest included)
**/testcases/
**/*.zip

# Python
__pycache__/
framework/__pycache__/
*.pyc
*.pyo

# Compiled binaries
*.exe
*.out
*.o

